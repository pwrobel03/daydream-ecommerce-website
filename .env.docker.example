# -----------------------------------------------------------------------------
# Konfiguracja dla `docker compose up`.
#
#   cp .env.docker.example .env.docker
#
# DATABASE_URL, REDIS_URL i UPLOAD_DIR ustawia samo compose — nie ma ich tutaj.
# -----------------------------------------------------------------------------

# Wygeneruj: npx auth secret
AUTH_SECRET="change_me_generate_with_npx_auth_secret"

AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth (opcjonalne). Przycisk dostawcy pojawia się tylko wtedy, gdy ustawisz
# obie zmienne jego pary; ustawienie tylko jednej przerywa start aplikacji.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# Stripe w trybie testowym. Bez prawdziwych kluczy katalog i koszyk działają,
# a przejście do płatności kończy się błędem sesji.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Poczta. SMTP_HOST i SMTP_PORT ustawia compose (usługa mailpit) — tutaj
# podajesz tylko adres nadawcy. Wysłane maile obejrzysz na http://localhost:8025
MAIL_FROM="Daydream <hello@daydream.local>"

# Hard caps on outgoing e-mail (ADR 0012). Optional; the values below are the defaults.
MAIL_DAILY_LIMIT="50"
MAIL_HOURLY_LIMIT_PER_ADDRESS="3"
MAIL_HOURLY_LIMIT_PER_IP="3"

# Strona /privacy: administrator danych i dostawca poczty. Wszystkie trzy są
# wymagane; właściciel uzupełnia je przy wdrożeniu.
PRIVACY_CONTROLLER_NAME="Example Owner"
PRIVACY_CONTACT_EMAIL="privacy@example.com"
PRIVACY_EMAIL_PROVIDER="Example SMTP Provider"

# Domena dla wariantu produkcyjnego (docker-compose.prod.yml).
# W demo nieużywana.
DOMAIN="daydream.example.com"

# Sekret endpointu zwalniającego rezerwacje (min. 16 znaków)
CRON_SECRET="change_me_to_a_long_random_string"

# Cloudflare Turnstile (rejestracja, reset hasła). To testowe klucze Cloudflare,
# które zawsze przechodzą; na produkcji podstaw klucze widżetu z panelu.
TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Wypełnia bazę katalogiem demonstracyjnym przy starcie.
# Po pierwszym uruchomieniu można ustawić na false.
RUN_SEED="true"

# Port hosta i hasło do bazy są ustawione wprost w docker-compose.yml —
# nie przez interpolację, bo compose wciągałby do niej deweloperski `.env`.
