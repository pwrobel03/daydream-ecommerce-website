# -----------------------------------------------------------------------------
# Konfiguracja dla `docker compose up`.
#
#   cp .env.docker.example .env.docker
#
# DATABASE_URL, REDIS_URL i UPLOAD_DIR ustawia samo compose — nie ma ich tutaj.
# -----------------------------------------------------------------------------

# Wygeneruj: npx auth secret
AUTH_SECRET="change_me_generate_with_npx_auth_secret"

AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth. Bez prawdziwych kluczy logowanie hasłem działa,
# a przyciski Google/GitHub zwrócą błąd dostawcy.
AUTH_GOOGLE_ID="placeholder"
AUTH_GOOGLE_SECRET="placeholder"
AUTH_GITHUB_ID="placeholder"
AUTH_GITHUB_SECRET="placeholder"

# Stripe w trybie testowym. Bez prawdziwych kluczy katalog i koszyk działają,
# a przejście do płatności kończy się błędem sesji.
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Poczta. SMTP_HOST i SMTP_PORT ustawia compose (usługa mailpit) — tutaj
# podajesz tylko adres nadawcy. Wysłane maile obejrzysz na http://localhost:8025
MAIL_FROM="Daydream <hello@daydream.local>"

# Domena dla wariantu produkcyjnego (docker-compose.prod.yml).
# W demo nieużywana.
DOMAIN="daydream.example.com"

# Sekret endpointu zwalniającego rezerwacje (min. 16 znaków)
CRON_SECRET="change_me_to_a_long_random_string"

# Wypełnia bazę katalogiem demonstracyjnym przy starcie.
# Po pierwszym uruchomieniu można ustawić na false.
RUN_SEED="true"

# Port hosta i hasło do bazy są ustawione wprost w docker-compose.yml —
# nie przez interpolację, bo compose wciągałby do niej deweloperski `.env`.
