# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for your PostgreSQL instance (e.g., Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/daydream"

# -----------------------------------------------------------------------------
# AUTHENTICATION (Auth.js / NextAuth)
# -----------------------------------------------------------------------------
# Generate a secure secret using: npx auth secret
AUTH_SECRET="your_auth_secret_here"

# The base URL of your application (usually http://localhost:3000 for development)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS (Google & GitHub)
# -----------------------------------------------------------------------------
# Obtain these from the Google Cloud Console (Credentials section)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Obtain these from GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_secret"

# -----------------------------------------------------------------------------
# STRIPE (Payments)
# -----------------------------------------------------------------------------
# Secret API Key from Stripe Dashboard (Test Mode)
STRIPE_API_KEY="sk_test_your_secret_key"

# Publishable Key from Stripe Dashboard (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key"

# Obtained via Stripe CLI during local webhook testing (stripe listen)
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# For images in public folder
NEXT_PUBLIC_ASSETS_URL=""

# -----------------------------------------------------------------------------
# RESEND (Email Service)
# -----------------------------------------------------------------------------
# API Key from your Resend.com dashboard
RESEND_API_KEY="re_your_api_key"
MAILING_ACCOUNT="re_email_accept"
MAILING_ACCOUNT_PROVIDER=onboarding@resend.dev