# -----------------------------------------------------------------------------
# Wzór konfiguracji. Skopiuj do .env i uzupełnij wartościami.
# Wszystkie klucze są walidowane przy starcie aplikacji przez lib/env.ts —
# brakująca lub niepoprawna zmienna zatrzyma proces z czytelnym komunikatem.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string for your PostgreSQL instance (e.g., Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/daydream"

# -----------------------------------------------------------------------------
# AUTHENTICATION (Auth.js v5)
# -----------------------------------------------------------------------------
# Generate a secure secret using: npx auth secret
AUTH_SECRET="your_auth_secret_here"

# Base URL of the application, used by Auth.js for callbacks
AUTH_URL="http://localhost:3000"

# Required when running behind a proxy or a non-localhost host (e.g. Vercel)
AUTH_TRUST_HOST="true"

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS (Google & GitHub)
# -----------------------------------------------------------------------------
# Auth.js v5 picks these up automatically — the AUTH_<PROVIDER>_ID / _SECRET
# naming is required, the keys are not passed explicitly in auth.config.ts.

# Obtain these from the Google Cloud Console (Credentials section)
AUTH_GOOGLE_ID="your_google_client_id"
AUTH_GOOGLE_SECRET="your_google_client_secret"

# Obtain these from GitHub Developer Settings -> OAuth Apps
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# -----------------------------------------------------------------------------
# STRIPE (Payments)
# -----------------------------------------------------------------------------
# Secret API Key from Stripe Dashboard (Test Mode)
STRIPE_SECRET_KEY="sk_test_your_secret_key"

# Obtained via Stripe CLI during local webhook testing:
# stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# -----------------------------------------------------------------------------
# RESEND (Email Service)
# -----------------------------------------------------------------------------
# API Key from your Resend.com dashboard
RESEND_API_KEY="re_your_api_key"

# Verified sender address (onboarding@resend.dev works in Resend sandbox mode)
MAILING_ACCOUNT_PROVIDER="onboarding@resend.dev"

# Recipient used while the sending domain is not verified in Resend
MAILING_ACCOUNT="your_verified_inbox@example.com"

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# REDIS (rate limiting)
# -----------------------------------------------------------------------------
# In docker-compose this resolves to the redis service; locally run
# `docker compose up -d redis` or point it at your own instance.
REDIS_URL="redis://localhost:6379"

# Shared secret for the reservation-release cron endpoint (min. 16 chars)
CRON_SECRET="generate_a_long_random_string"

# Public base URL — used for Stripe redirects and links in transactional emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"
